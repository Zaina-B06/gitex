# Copy to .env and fill in locally. Never commit .env.
# LLM layer (TASK_01_C, teammate): provider-agnostic; leave unused keys empty. The API works without them.
LLM_PROVIDER=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_KEY=
OPENAI_MODEL=

# API (Task 03)
# Default when empty: sqlite:///rebound.db
DATABASE_URL=
# true = enable /demo/* (time travel, seeding). Leave empty in production.
DEMO_MODE=
# Secret for POST /demo/seed, sent as the X-Demo-Key header. Empty = seeding refused.
DEMO_KEY=
# Shared key for GET /dashboard/employer, sent as the X-Org-Key header. Empty = employer view refused.
ORG_KEY=
# Deployed frontend origin for CORS, e.g. https://rebound.example.app
FRONTEND_URL=
# true = also allow http://localhost:5173 (local frontend dev). DEMO_MODE=true allows it too.
DEV_MODE=
