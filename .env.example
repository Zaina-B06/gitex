# Copy to .env and fill in locally. Never commit .env.
# LLM layer (TASK_01_C, llm/README.md): only classifies check-in free text into a barrier. Leave empty to use
# keywords; the API works fully without it. LLM_PROVIDER = groq | openai | azure; fill only that provider's keys.
LLM_PROVIDER=
GROQ_API_KEY=
# e.g. openai/gpt-oss-20b (check which models your key has: GET https://api.groq.com/openai/v1/models)
GROQ_MODEL=
# true = the LLM may also ADD a red flag the keywords missed (never remove one). Off when empty.
LLM_RED_FLAG_CHECK=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_KEY=
OPENAI_MODEL=

# API (Task 03)
# Default when empty: sqlite:///rebound.db
DATABASE_URL=
# true = enable /demo/* (time travel, seeding). Leave empty in production.
DEMO_MODE=
# Secret for POST /demo/seed, sent as the X-Demo-Key header. Empty = seeding refused.
DEMO_KEY=
# Shared key for GET /dashboard/employer, sent as the X-Org-Key header. Empty = employer view refused.
ORG_KEY=
# Deployed frontend origin for CORS, e.g. https://rebound.example.app
FRONTEND_URL=
# true = also allow http://localhost:5173 (local frontend dev). DEMO_MODE=true allows it too.
DEV_MODE=
