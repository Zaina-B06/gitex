# Copy to .env and fill in locally. Never commit .env.
# LLM layer (TASK_01_C, teammate): provider-agnostic; leave unused keys empty. The API works without them.
LLM_PROVIDER=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_KEY=

# API (Task 03)
# Default when empty: sqlite:///rebound.db
DATABASE_URL=
# true = enable /demo/* (time travel, seeding). Leave empty in production.
DEMO_MODE=
# Deployed frontend origin for CORS, e.g. https://rebound.example.app (http://localhost:5173 is always allowed)
FRONTEND_URL=
