 "components": {
  "schemas": {
   "Accessibility": {
    "type": "string",
    "enum": [
     "large_text",
     "high_contrast",
     "screen_reader"
    ],
    "title": "Accessibility"
   },
   "Action": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "behaviour": {
      "$ref": "#/components/schemas/Behaviour"
     },
     "tier": {
      "type": "integer",
      "maximum": 4.0,
      "minimum": 1.0,
      "title": "Tier"
     },
     "title": {
      "$ref": "#/components/schemas/LocalizedText"
     },
     "bct_code": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Bct Code"
     },
     "bct_name": {
      "type": "string",
      "title": "Bct Name"
     },
     "rationale": {
      "type": "string",
      "title": "Rationale"
     },
     "limits": {
      "type": "string",
      "title": "Limits"
     },
     "setting": {
      "$ref": "#/components/schemas/ActionSetting"
     },
     "fasting_safe": {
      "type": "boolean",
      "title": "Fasting Safe"
     },
     "low_energy_ok": {
      "type": "boolean",
      "title": "Low Energy Ok"
     },
     "pregnancy_safe": {
      "type": "boolean",
      "title": "Pregnancy Safe"
     },
     "seated": {
      "type": "boolean",
      "title": "Seated",
      "default": false
     },
     "seated_variant_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Seated Variant Id"
     },
     "contraindications": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Contraindications"
     },
     "duration_min": {
      "type": "integer",
      "exclusiveMinimum": 0.0,
      "title": "Duration Min"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "id",
     "behaviour",
     "tier",
     "title",
     "bct_code",
     "bct_name",
     "rationale",
     "limits",
     "setting",
     "fasting_safe",
     "low_energy_ok",
     "pregnancy_safe",
     "duration_min"
    ],
    "title": "Action"
   },
   "ActionSetting": {
    "type": "string",
    "enum": [
     "indoor",
     "outdoor",
     "any"
    ],
    "title": "ActionSetting"
   },
   "AdvanceIn": {
    "properties": {
     "days": {
      "type": "integer",
      "maximum": 60.0,
      "minimum": 1.0,
      "title": "Days"
     },
     "pattern": {
      "type": "string",
      "enum": [
       "good",
       "lapse",
       "mixed"
      ],
      "title": "Pattern"
     },
     "scenario": {
      "anyOf": [
       {
        "type": "string",
        "enum": [
         "ramadan",
         "heat"
        ]
       },
       {
        "type": "null"
       }
      ],
      "title": "Scenario"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "days",
     "pattern"
    ],
    "title": "AdvanceIn"
   },
   "AdvanceOut": {
    "properties": {
     "state": {
      "$ref": "#/components/schemas/StateOut"
     },
     "today": {
      "$ref": "#/components/schemas/TodayOut"
     },
     "log": {
      "items": {
       "$ref": "#/components/schemas/DayRow"
      },
      "type": "array",
      "title": "Log"
     }
    },
    "type": "object",
    "required": [
     "state",
     "today",
     "log"
    ],
    "title": "AdvanceOut"
   },
   "Barrier": {
    "type": "string",
    "enum": [
     "time",
     "energy_fatigue",
     "illness_pain",
     "schedule_change",
     "environment",
     "low_motivation",
     "social_family",
     "forgot",
     "other"
    ],
    "title": "Barrier"
   },
   "BarrierCount": {
    "properties": {
     "barrier": {
      "$ref": "#/components/schemas/Barrier"
     },
     "count": {
      "type": "integer",
      "title": "Count"
     }
    },
    "type": "object",
    "required": [
     "barrier",
     "count"
    ],
    "title": "BarrierCount"
   },
   "Baseline": {
    "properties": {
     "active_days_per_week": {
      "type": "integer",
      "maximum": 7.0,
      "minimum": 0.0,
      "title": "Active Days Per Week"
     },
     "typical_daily_steps": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 100000.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Typical Daily Steps"
     },
     "sleep_hours_typical": {
      "type": "number",
      "maximum": 24.0,
      "minimum": 0.0,
      "title": "Sleep Hours Typical"
     },
     "sleep_quality_self": {
      "type": "integer",
      "maximum": 5.0,
      "minimum": 1.0,
      "title": "Sleep Quality Self"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "active_days_per_week",
     "sleep_hours_typical",
     "sleep_quality_self"
    ],
    "title": "Baseline"
   },
   "Basics": {
    "properties": {
     "language": {
      "$ref": "#/components/schemas/Language"
     },
     "age_years": {
      "type": "integer",
      "maximum": 100.0,
      "minimum": 18.0,
      "title": "Age Years"
     },
     "sex": {
      "$ref": "#/components/schemas/Sex"
     },
     "goals": {
      "items": {
       "$ref": "#/components/schemas/Behaviour"
      },
      "type": "array",
      "minItems": 1,
      "title": "Goals"
     },
     "schedule_type": {
      "$ref": "#/components/schemas/ScheduleType"
     },
     "usual_wake_time": {
      "type": "string",
      "format": "time",
      "title": "Usual Wake Time"
     },
     "usual_sleep_time": {
      "type": "string",
      "format": "time",
      "title": "Usual Sleep Time"
     },
     "work_hours": {
      "items": {
       "$ref": "#/components/schemas/TimeRange"
      },
      "type": "array",
      "title": "Work Hours"
     },
     "shift_cycle": {
      "anyOf": [
       {
        "items": {
         "items": {
          "$ref": "#/components/schemas/TimeRange"
         },
         "type": "array"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Shift Cycle"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "language",
     "age_years",
     "sex",
     "goals",
     "schedule_type",
     "usual_wake_time",
     "usual_sleep_time"
    ],
    "title": "Basics"
   },
   "Behaviour": {
    "type": "string",
    "enum": [
     "movement",
     "sleep"
    ],
    "title": "Behaviour"
   },
   "Body": {
    "properties": {
     "height_cm": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 250.0,
        "minimum": 100.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Height Cm"
     },
     "weight_kg": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 300.0,
        "minimum": 30.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Weight Kg"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "title": "Body",
    "description": "Used only to set a safe starting intensity, never shown as a target."
   },
   "Channel": {
    "type": "string",
    "enum": [
     "app",
     "whatsapp_style",
     "voice_note"
    ],
    "title": "Channel"
   },
   "CheckinIn": {
    "properties": {
     "barriers": {
      "items": {
       "$ref": "#/components/schemas/Barrier"
      },
      "type": "array",
      "title": "Barriers"
     },
     "free_text": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 500
       },
       {
        "type": "null"
       }
      ],
      "title": "Free Text"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "title": "CheckinIn"
   },
   "CheckinOut": {
    "properties": {
     "barrier": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Barrier"
       },
       {
        "type": "null"
       }
      ]
     },
     "adjusted_actions": {
      "items": {
       "$ref": "#/components/schemas/Action"
      },
      "type": "array",
      "title": "Adjusted Actions"
     },
     "message_key": {
      "type": "string",
      "title": "Message Key"
     },
     "red_flag": {
      "type": "boolean",
      "title": "Red Flag"
     },
     "message": {
      "type": "string",
      "title": "Message"
     }
    },
    "type": "object",
    "required": [
     "barrier",
     "adjusted_actions",
     "message_key",
     "red_flag",
     "message"
    ],
    "title": "CheckinOut"
   },
   "ConsentGroup": {
    "type": "string",
    "enum": [
     "body",
     "screening",
     "history",
     "preferences"
    ],
    "title": "ConsentGroup"
   },
   "ContextFlag": {
    "type": "string",
    "enum": [
     "ramadan",
     "heat",
     "shift_pattern",
     "travel",
     "illness",
     "paused"
    ],
    "title": "ContextFlag"
   },
   "DayLog": {
    "properties": {
     "day": {
      "type": "integer",
      "title": "Day"
     },
     "behaviour": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Behaviour"
       },
       {
        "type": "null"
       }
      ]
     },
     "action_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Action Id"
