# Base URL of the backend API.
# Leave blank in dev — the Vite proxy routes /api/* to http://127.0.0.1:8000.
# Set to your deployed HTTPS backend URL in production.
VITE_API_URL=

# Set true to show the Demo panel (judge / presentation build only).
VITE_DEMO_MODE=false

# Optional: the demo key for "Try a demo person" and the demo bar. Anything starting with VITE_ is built into the
# public JavaScript, so only set this for a demo build. Leave it empty and the app asks once per tab instead
# (kept in sessionStorage only). ORG_KEY is never put here.
VITE_DEMO_KEY=
