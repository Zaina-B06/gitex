# Base URL of the backend API.
# Leave blank in dev — the Vite proxy routes /api/* to http://127.0.0.1:8000.
# Set to your deployed HTTPS backend URL in production.
VITE_API_URL=

# Set true to show the Demo panel (judge / presentation build only).
VITE_DEMO_MODE=false

# DEMO_KEY and ORG_KEY are NOT here.
# They are entered at runtime in the app UI and stored in sessionStorage only.
